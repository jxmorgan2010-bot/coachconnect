// CoachConnect data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  PARENT
  COACH
  ADMIN
}

enum Sport {
  BASKETBALL
  SOCCER
  FOOTBALL
  LACROSSE
  TENNIS
  PICKLEBALL
  BASEBALL
  SOFTBALL
}

enum SchoolLevel {
  HIGH_SCHOOL
  COLLEGE
}

enum IdVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BackgroundCheckStatus {
  NOT_STARTED
  PENDING
  CLEAR
  FLAGGED
}

enum PayoutStatus {
  NOT_STARTED
  PENDING
  COMPLETE
}

enum RecommendationStatus {
  REQUESTED
  SUBMITTED
}

enum BookingStatus {
  PENDING_CONSENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReportTargetType {
  COACH_PROFILE
  PARENT_PROFILE
  MESSAGE
  SUPPORT_REQUEST
}

enum PaymentStatus {
  AUTHORIZED
  CAPTURED
  CANCELLED
  REFUNDED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum DisputeReason {
  NO_SHOW
  DISSATISFIED
  OTHER
}

enum DisputeStatus {
  OPEN
  INFO_REQUESTED
  REFUNDED
  SIDED_WITH_COACH
  DISMISSED
}

enum PackageStatus {
  ACTIVE
  DEPLETED
}

enum PointsActionType {
  SESSION_COMPLETED
  REVIEW_LEFT
  REFERRAL_SIGNUP
  QUICK_REBOOK
  REDEEMED_FOR_CREDIT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parentProfile ParentProfile?
  coachProfile  CoachProfile?
  sentMessages  Message[]
  reports       Report[]
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  createdAt DateTime @default(now())

  stripeCustomerId      String?         @unique

  referralCode          String          @unique
  creditCents           Int             @default(0)
  referredById          String?
  referredBy            ParentProfile?  @relation("Referrals", fields: [referredById], references: [id])
  referredParents       ParentProfile[] @relation("Referrals")

  // Loyalty points — see src/lib/points.ts. pointsBalance is spendable (redemptions
  // decrement it); nothing currently reads a lifetime total for parents so there's no
  // separate lifetime field here (contrast CoachProfile.lifetimePoints, used for the
  // Top Coach badge threshold, which must NOT drop when a coach's points are spent).
  pointsBalance Int @default(0)

  children  Child[]
  bookings  Booking[]
  reviews   Review[]
  threads   Thread[]
  disputes  Dispute[]
  packages  SessionPackage[]
  pointsTransactions PointsTransaction[]
}

model Child {
  id              String        @id @default(cuid())
  parentProfileId String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  firstName       String
  gradeOrAge      String
  notes           String?
  createdAt       DateTime      @default(now())

  bookings          Booking[]
  trainingPlanItems TrainingPlanItem[]
}

model CoachProfile {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio              String?
  schoolLevel      SchoolLevel?
  schoolName       String?
  gradYear         Int?
  hourlyRateCents  Int?
  city             String?
  state            String?

  profilePhotoUrl  String?
  idPhotoPath      String?

  idVerificationStatus   IdVerificationStatus   @default(PENDING)
  backgroundCheckStatus  BackgroundCheckStatus  @default(NOT_STARTED)
  backgroundCheckRef     String?
  backgroundCheckExpiresAt DateTime?
  payoutStatus           PayoutStatus           @default(NOT_STARTED)
  conductAcknowledged    Boolean                @default(false)

  isSuspended   Boolean   @default(false)
  suspendedAt   DateTime?

  zip               String?

  // Bio video — three independently-recordable clips (intro, coaching, playing). Entirely
  // optional; a coach with all three uploaded gets a "Video verified" trust badge.
  introClipUrl        String?
  introClipSeconds    Int?
  coachingClipUrl     String?
  coachingClipSeconds Int?
  playingClipUrl      String?
  playingClipSeconds  Int?

  // Under-18 coach tier — structure only. Gated behind the ENABLE_MINOR_COACHES flag
  // (see src/lib/flags.ts) until legal requirements are confirmed; do not treat the
  // presence of these fields as meaning the tier is live.
  dateOfBirth   DateTime?
  isMinorCoach  Boolean   @default(false)

  // Consent from the coach's OWN parent/guardian (distinct from a booking family's consent).
  // The coach requests consent, which generates minorConsentToken; the guardian fills out
  // and signs the rest themselves at /minor-consent/[token], mirroring the Recommendation
  // token-link pattern below rather than letting the coach self-attest on their behalf.
  minorConsentToken         String?   @unique
  minorGuardianName         String?
  minorGuardianRelationship String?
  minorGuardianEmail        String?
  minorGuardianConsentedAt  DateTime?

  // Standard automated background checks may not apply to minor coaches. This is an
  // admin-only free-text note recording whatever alternative verification was actually
  // done — manual for now, pending legal confirmation of what's required.
  minorBackgroundCheckNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Loyalty points — see src/lib/points.ts. pointsBalance is spendable; lifetimePoints
  // never decrements, so the "Top Coach" badge (a threshold on lifetimePoints) can't be
  // lost by spending points elsewhere in the future.
  pointsBalance  Int @default(0)
  lifetimePoints Int @default(0)

  sports          CoachSport[]
  availability    Availability[]
  bookings        Booking[]
  reviews         Review[]
  threads         Thread[]
  recommendations Recommendation[]
  disputes        Dispute[]
  packages        SessionPackage[]
  pointsTransactions PointsTransaction[]
  trainingPlanItems  TrainingPlanItem[]
}

/**
 * A prepaid bundle of sessions with one coach, for one sport, bought upfront at a
 * discount off calculateBundlePricing() (see src/lib/bundles.ts). Scoped to
 * coach+sport, not to a specific child — any of the parent's kids can draw a session
 * from it. Unlike a normal Booking (a manual-capture hold released on completion), the
 * full discounted total is captured immediately at purchase; individual bookings drawn
 * from the package need no further Stripe hold (see POST /api/bookings's packageId
 * branch), which is why pricePerSessionCents/discountPercent/durationMinutes are
 * snapshotted here rather than re-read from the coach profile later.
 */
model SessionPackage {
  id                    String        @id @default(cuid())
  parentProfileId       String
  parentProfile         ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  coachProfileId        String
  coachProfile          CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  sport                 Sport
  durationMinutes       Int
  totalSessions         Int
  sessionsUsed          Int           @default(0)
  // Sessions given back to the package after a no-show on a bundled booking — see the
  // packageId branch of POST /api/bookings/[id]/no-show. Audit/display only.
  sessionsRefunded      Int           @default(0)
  pricePerSessionCents  Int
  discountPercent       Int
  totalChargedCents     Int
  status                PackageStatus @default(ACTIVE)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())

  bookings              Booking[]
}

/**
 * A running ledger of points earned/redeemed by a parent or coach (exactly one of
 * parentProfileId/coachProfileId is set) — see src/lib/points.ts for point values and
 * award/redeem logic. Redeeming converts points into the parent's existing
 * ParentProfile.creditCents wallet (the same one bookingValidation.ts already applies
 * automatically) rather than a separate discount mechanism.
 */
model PointsTransaction {
  id              String            @id @default(cuid())
  parentProfileId String?
  parentProfile   ParentProfile?    @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  coachProfileId  String?
  coachProfile    CoachProfile?     @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         Booking?          @relation(fields: [bookingId], references: [id])
  action          PointsActionType
  points          Int
  createdAt       DateTime          @default(now())
}

/**
 * A lightweight, checkable list of drills/focus areas a coach sets up for one
 * (coach, child, sport) pairing — visible and toggleable by both the coach and the
 * child's parent, between-session homework rather than a per-session progress note
 * (which already exists on Booking).
 */
model TrainingPlanItem {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  childId        String
  child          Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  sport          Sport
  label          String
  isDone         Boolean      @default(false)
  completedAt    DateTime?
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
}

model CoachSport {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  sport          Sport

  @@unique([coachProfileId, sport])
}

model Availability {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0 = Sunday ... 6 = Saturday
  startMinute    Int // minutes after midnight
  endMinute      Int
}

model Recommendation {
  id             String                @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile          @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  token          String                @unique
  recommenderName  String?
  recommenderRole  String?
  content          String?
  status           RecommendationStatus @default(REQUESTED)
  createdAt        DateTime             @default(now())
  submittedAt      DateTime?
}

model Booking {
  id                String        @id @default(cuid())
  parentProfileId   String
  parentProfile     ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  coachProfileId    String
  coachProfile      CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  childId           String?
  child             Child?        @relation(fields: [childId], references: [id])
  sport             Sport
  scheduledAt       DateTime
  durationMinutes   Int
  locationText      String
  priceCents        Int
  platformFeeCents  Int
  discountCents     Int           @default(0)
  status            BookingStatus @default(PENDING_CONSENT)
  parentalConsent   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  completedAt       DateTime?

  paymentStatus     PaymentStatus @default(AUTHORIZED)
  capturedAt        DateTime?
  autoCompleted     Boolean       @default(false)
  tipCents          Int           @default(0)
  tippedAt          DateTime?

  stripePaymentIntentId String?   @unique
  stripePaymentMethodId String?

  videoCallUrl      String?

  // Required whenever the booked coach is a minor coach (see CoachProfile.isMinorCoach) —
  // the name of the additional adult, beyond the booking parent, who'll be present.
  secondAdultName   String?

  reminder24SentAt  DateTime?
  reminder1hSentAt  DateTime?

  progressWhatWorkedOn String?
  progressNextFocus    String?
  progressNoteAddedAt  DateTime?

  // Set only when this session was drawn from a prepaid SessionPackage — see the
  // packageId branch of POST /api/bookings. Such bookings skip the normal per-session
  // Stripe hold (stripePaymentIntentId stays null; paymentStatus starts CAPTURED).
  packageId         String?
  package           SessionPackage? @relation(fields: [packageId], references: [id])

  review              Review?
  dispute             Dispute?
  pointsTransactions  PointsTransaction[]
}

model Review {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  parentProfileId String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  coachProfileId  String
  coachProfile    CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  rating          Int
  comment         String?
  createdAt       DateTime      @default(now())
}

model Thread {
  id              String        @id @default(cuid())
  parentProfileId String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  coachProfileId  String
  coachProfile    CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  messages        Message[]

  @@unique([parentProfileId, coachProfileId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  body       String
  createdAt  DateTime @default(now())
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation(fields: [reporterId], references: [id])
  targetType   ReportTargetType
  targetId     String
  reason       String
  details      String?
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now())
}

model Dispute {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  parentProfileId String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  coachProfileId  String
  coachProfile    CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  reason          DisputeReason
  details         String
  status          DisputeStatus @default(OPEN)
  refundCents     Int?
  adminNote       String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?
}
